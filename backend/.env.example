# NCPOR Digital Knowledge Platform - Backend Environment Configuration

# Gemini API Key to unlock full GenAI Graph-RAG capabilities
# Obtain a free key from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Recommended Gemini model for fast, accurate multimodal polar science reasoning
GEMINI_MODEL=gemini-3.8-flash

# Optional: set to 'neo4j' if running with a Neo4j cluster (defaults to bundled NetworkX)
GRAPH_BACKEND=networkx
